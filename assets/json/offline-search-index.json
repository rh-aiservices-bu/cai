{{- $scope := .Site.Params.offline_search_index | default "content" | lower -}}
{{- if not (in (slice "title" "heading" "summary" "content") $scope) -}}
  {{- warnf "invalid params.offline_search_index %q (allowed: title | heading | summary | content); using content" $scope -}}
  {{- $scope = "content" -}}
{{- end -}}
{{- $summaryLength := partial "validate.html" (dict
    "value" .Site.Params.offline_search_summary_length "kind" "int"
    "min" 1 "fallback" 70 "key" "params.offline_search_summary_length") -}}
{{- $documents := slice -}}
{{- $pages := where .Site.Pages "Kind" "in" (slice "page" "section") -}}
{{- range $pages -}}
{{- if .Params.search_exclude }}{{ continue }}{{ end -}}
{{- if or (not .RelPermalink) .Params.sidebar_divider }}{{ continue }}{{ end -}}
{{- if not .RawContent }}{{ continue }}{{ end -}}
{{- /* Site.Pages can retain the context of an earlier RSS/Print/Markdown
     traversal. Search reads semantic HTML and must not cache that output's
     fallback as the page's Content. Restore the caller's flag afterwards. */ -}}
{{- $previousFormat := .Store.Get "tdOutputFormat" -}}
{{- .Store.Set "tdOutputFormat" "html" -}}
{{- /* We have to apply `htmlUnescape` again after `truncate` because `truncate` applies `html.EscapeString` if the argument is not HTML. */ -}}
{{- /* Individual taxonomies can be added in the next line by add '"taxonomy-name" (.Params.taxonomy-name | default "")' to the dict (as seen for categories and tags). */ -}}
{{- $summary := "" -}}
{{- with .Description -}}
  {{- $summary = . | htmlUnescape | strings.TrimSpace -}}
{{- end -}}
{{- if not $summary -}}
  {{- $summary = .Summary | plainify | htmlUnescape | strings.TrimSpace -}}
{{- end -}}
{{- $headings := "" -}}
{{- $sections := dict -}}
{{- if ne $scope "title" -}}
  {{- $sections = partial "search/sections.html" (dict "page" . "scope" $scope) -}}
  {{- $titles := slice -}}
  {{- range $sections.sections }}{{ $titles = $titles | append .title }}{{ end -}}
  {{- $headings = delimit $titles " " -}}
{{- end -}}
{{- $plain := "" -}}
{{- if or (not $summary) (eq $scope "content") -}}
  {{- $plain = $sections.body | default (.Plain | htmlUnescape) -}}
{{- end -}}
{{- $excerpt := $summary | default $plain -}}
{{- $metadata := partial "search/metadata.html" . -}}
{{- $doc := merge $metadata (dict
      "ref" .RelPermalink
      "title" .Title
      "categories" (.Params.categories | default "")
      "tags" (.Params.tags | default "")
      "excerpt" ($excerpt | truncate $summaryLength | htmlUnescape)
) -}}
{{- with $sections.sections }}{{ $doc = merge $doc (dict "sections" .) }}{{ end -}}
{{- if eq $scope "heading" -}}
  {{- $doc = merge $doc (dict "headings" $headings) -}}
{{- else if eq $scope "summary" -}}
  {{- $doc = merge $doc (dict "headings" $headings "description" $summary) -}}
{{- else if eq $scope "content" -}}
  {{- $doc = merge $doc (dict
        "headings" $headings
        "description" $summary
        "body" $plain) -}}
{{- end -}}
{{- $documents = $documents | append $doc -}}
{{- if $previousFormat }}{{ .Store.Set "tdOutputFormat" $previousFormat }}{{ else }}{{ .Store.Delete "tdOutputFormat" }}{{ end -}}
{{- end -}}
{{- /* Project override: the home page carries its content in data-driven
landing sections (data/home/<lang>.yaml), so .RawContent is empty and the loop
above skips it even though the landing is this site's only document — and the
"page"/"section" kind filter excludes Kind "home" outright. Serialize the
landing through the same text partial as the markdown output so the search
index, index.md, and llms-full.txt cannot drift. */ -}}
{{- $homeBody := "" -}}
{{- with partial "landing/home-data.html" . -}}
  {{- $homeBody = partial "landing/text.html" (dict "page" $ "data" .) -}}
{{- end -}}
{{- with strings.TrimSpace $homeBody -}}
{{- $homeDesc := "" -}}
{{- with $.Description -}}{{- $homeDesc = strings.TrimSpace . -}}{{- end -}}
{{- $homeDoc := merge (partial "search/metadata.html" $) (dict
      "ref" $.RelPermalink
      "title" $.Title
      "root" "home"
      "section" "home"
      "categories" ($.Params.categories | default "")
      "tags" ($.Params.tags | default "")
      "excerpt" ($homeDesc | truncate $summaryLength | htmlUnescape)
) -}}
{{- if eq $scope "heading" -}}
  {{- $homeDoc = merge $homeDoc (dict "headings" "") -}}
{{- else if eq $scope "summary" -}}
  {{- $homeDoc = merge $homeDoc (dict "headings" "" "description" $homeDesc) -}}
{{- else -}}
  {{- $homeDoc = merge $homeDoc (dict "headings" "" "description" $homeDesc "body" .) -}}
{{- end -}}
{{- $documents = $documents | append $homeDoc -}}
{{- end -}}
{{- $documents | jsonify -}}
